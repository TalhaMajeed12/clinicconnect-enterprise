APP_NAME=ClinicConnect
APP_VERSION=3.0.0
FLASK_CONFIG=development
DEBUG=False

# PostgreSQL is required outside isolated tests.
DATABASE_URL=postgresql://username:password@localhost:5432/clinicconnect
SECRET_KEY=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-fernet-key
WTF_CSRF_SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-long-random-value

SESSION_COOKIE_SECURE=False
WTF_CSRF_ENABLED=True
RATELIMIT_ENABLED=False
CORS_ALLOWED_ORIGINS=https://clinicconnect-enterprise.onrender.com
REDIS_URL=
REDIS_PASSWORD=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
