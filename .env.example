APP_NAME=ClinicConnect
APP_VERSION=3.0.0
FLASK_CONFIG=development
DEBUG=False

# PostgreSQL is required outside isolated tests.
DATABASE_URL=postgresql://username:password@localhost:5432/clinicconnect
SECRET_KEY=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-fernet-key
WTF_CSRF_SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-long-random-value

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=10
EMAIL_PROVIDER=smtp
BREVO_API_KEY=

SESSION_COOKIE_SECURE=False
WTF_CSRF_ENABLED=True
RATELIMIT_ENABLED=False
CORS_ALLOWED_ORIGINS=https://clinicconnect-enterprise.onrender.com
REDIS_URL=
REDIS_PASSWORD=
AUDIT_RETENTION_DAYS=30

# Jitsi Meet is the default WebRTC provider. HTTPS is required for media access.
VIDEO_CONSULTATION_BASE_URL=https://meet.jit.si
VIDEO_JOIN_EARLY_MINUTES=15
VIDEO_JOIN_GRACE_MINUTES=30

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
